    {
      "image": 10,
      "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Harvard_drs_430994500_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf/page10-1920px-Harvard_drs_430994500_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf.jpg",
      "source_sha256": "1b9a4f78af6a399665bcf98125f1641785feffe23d385e9595b1d5db498b56db",
      "units": [
        {
          "id": "p010-c01",
          "kind": "stat",
          "text": "生小瘡六十人○爛管十二人○餘別症"
        },
        {
          "id": "p010-c02",
          "kind": "heading",
          "text": "心症共三人"
        },
        {
          "id": "p010-c03",
          "kind": "heading",
          "text": "皮膚症共一千一百九十二人"
        },
        {
          "id": "p010-c04",
          "kind": "stat",
          "text": "爛皮四百九十八人○疥瘡一百三十四人○新水螆一百二"
        },
        {
          "id": "p010-c05",
          "kind": "stat",
          "text": "十八人○舊水螆四十七人○癬瘡一百四十人○餘別症"
        },
        {
          "id": "p010-c06",
          "kind": "heading",
          "text": "養生症共六百五十五人"
        },
        {
          "id": "p010-c07",
          "kind": "stat",
          "text": "缺唇十八人○胃痛一百一十人○漏管九十七人○內痔三"
        },
        {
          "id": "p010-c08",
          "kind": "stat",
          "text": "十四人○外痔三十二人○蛀牙一百八十三人○痢疾三人"
        },
        {
          "id": "p010-c09",
          "kind": "stat",
          "text": "○便結十八人○餘別症"
        },
        {
          "id": "p010-c10",
          "kind": "heading",
          "text": "核症共一百一十人"
        },
        {
          "id": "p010-c11",
          "kind": "stat",
          "text": "核發炎七十二人○核中生癰九人○核大六人○餘別症"
        },
        {
          "id": "p010-c12",
          "kind": "heading",
          "text": "骨節症共一百四十一人"
        },
        {
